# Template for /etc/ned/env. deploy/bootstrap.sh copies it there once.
# Real values are filled in on the Pi only. This file never holds secrets.
NED_BODY=office
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
# Cartesia voice id (pick one in the Cartesia playground; see docs/decisions/0001)
CARTESIA_VOICE_ID=
# Optional overrides (defaults shown)
#NED_MODEL=claude-sonnet-5       # chat model; claude-opus-5 for the A/B (decision 0002)
#NED_EFFORT=low
#NED_THINKING=adaptive           # or disabled (Sonnet only; Opus misbehaves with it off)
#NED_FOLLOW_UP_SECS=8
#NED_EOT_THRESHOLD=0.7           # Deepgram end-of-turn confidence; lower = answers sooner
#NED_EAGER_EOT_THRESHOLD=        # e.g. 0.5 starts Claude early, cancels if you keep talking
#NED_WAKE_THRESHOLD=0.5          # see docs/wakeword.md, "False wakes"
#NED_WAKE_FRAMES=2
#NED_WAKE_VAD=0.5                # 0 turns the speech gate off
#NED_WAKE_VERIFIER=/home/mike/ned-robot/models/hey_ned_verifier.pkl
#NED_AUDIO_DEVICE=Array
#NED_LOG_DIR=/home/mike/ned-logs
